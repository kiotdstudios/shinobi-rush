# Keep CI tooling, workflows and Godot text files LF so a Windows checkout (core.autocrlf=true) can never
# commit CRLF that breaks a Linux runner. Only file types the pipeline reads are listed on purpose:
# existing docs and art keep their current behaviour.
*.py     text eol=lf
*.mjs    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env    text eol=lf
*.sh     text eol=lf
*.gd     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.cfg    text eol=lf
*.import text eol=lf
*.uid    text eol=lf
