extends RefCounted
func run(ck: Callable, root: Node) -> void:
	var p := (load("res://scenes/art/flicker_combat_proof.tscn") as PackedScene).instantiate() as FlickerCombatProof
	root.add_child(p)
	p.set_physics_process(false)
	await root.get_tree().process_frame
	await root.get_tree().physics_frame
	await root.get_tree().physics_frame
	ck.call("flicker proof: interactive, no automatic sequence", p.attack_index == 0 and not p.visual.active)
	p.double_back()
	ck.call("flicker proof: double escape requires two hits", p.double_count == 0 and not p.visual.active)
	p.attack()
	p.attack()
	p._physics_process(0.15)
	ck.call("flicker proof: second hit buffers without idle", p.attack_index == 2 and p.combo_hits == 2)
	p._physics_process(0.35)
	ck.call("flicker proof: two hits do not force an escape", p.attack_index == 0 and p.double_count == 0 and p.traversal_count == 0)
	p.double_back()
	p._physics_process(0.02)
	ck.call("flicker proof: selected retreat vanishes and moves", not p.visual.actor.visible and p.traversal_count == 1 and p.actor.global_position.distance_to(p.arena.spawn.global_position) > 50)
	p._physics_process(0.10)
	ck.call("flicker proof: first crisp reappearance", p.visual.actor.visible and p.visual.active)
	p._physics_process(0.04)
	p._physics_process(0.02)
	ck.call("flicker proof: staggered second vanish", p.traversal_count == 2 and not p.visual.actor.visible)
	p._physics_process(0.10)
	ck.call("flicker proof: clean double completion", not p.visual.active and p.visual.actor.visible and not p.visual.ghost.visible and not p.visual.effect.visible and p.vanish_count == 2 and p.reappear_count == 2)
	for i in 12:
		p.single_flicker()
		p._physics_process(0.5)
		ck.call("flicker proof: rapid repeated recovery%d" % i, not p.visual.active and p.visual.actor.visible and not p.visual.ghost.visible and not p.visual.effect.visible)
		p._physics_process(0.016)
		ck.call("flicker proof: completed ghost stays cleared%d" % i, not p.visual.ghost.visible)
	p.single_flicker()
	p._physics_process(0.02)
	p.toggle_inspection()
	ck.call("flicker proof: inspection interrupts invisibility", p.inspection and p.visual.actor.visible and not p.visual.ghost.visible and not p.visual.effect.visible)
	p.toggle_inspection()
	ck.call("flicker proof: leaving inspection restores ready", not p.inspection and not p.visual.active and p.visual.actor.visible)
	p.single_flicker()
	p._physics_process(0.02)
	Input.action_press("move_right")
	p._physics_process(0.016)
	Input.action_release("move_right")
	ck.call("flicker proof: direction change interruption restores body", not p.visual.active and p.visual.actor.visible)
	p.reset()
	p.single_flicker()
	p.attack()
	p._physics_process(0.5)
	ck.call("flicker proof: reengage buffers into attack", p.attack_index == 1 and p.visual.actor.visible)
	p.reset()
	p.actor.global_position = Vector2(p.arena.bounds.position.x + 80, p.arena.bounds.position.y + 200)
	await root.get_tree().physics_frame
	p.visual.begin(Vector2.LEFT, 2)
	p._physics_process(0.5)
	ck.call("flicker proof: swept retreat stops at existing wall", p.actor.position.x >= p.arena.bounds.position.x + WorldScale.FOOTPRINT.x * 0.5 - 0.1 and p.blocked_count > 0)
	ck.call("flicker proof: collision always enabled", not (p.actor.get_child(0) as CollisionShape2D).disabled)
	ck.call("flicker proof: large time step still catches both beats", not p.visual.active and p.visual.actor.visible and not p.visual.ghost.visible)
	p.queue_free()
	await root.get_tree().process_frame
