# Single source of truth for CI tool pins. Read by the workflows AND by the local scripts.
# Format: KEY=value, one per line, no quotes, no spaces, no 'export'. Validated by scripts/ci/pins.py.
# How to bump: docs/development/GODOT_CI_AND_DEPLOYMENT.md ("Bumping pins"). Never edit one Godot value alone:
# the editor zips and the export templates must come from the SAME release tag.

# Godot (stable releases only; tag = GODOT_VERSION + "-stable"; templates dir = GODOT_VERSION + ".stable").
# Values come from the SHA512-SUMS.txt asset of the matching godotengine/godot-builds release.
GODOT_VERSION=4.7.2
GODOT_EDITOR_LINUX_X86_64_SHA512=9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65
GODOT_EDITOR_WIN64_SHA512=83decd58fdf67b9d657958a1ae6bf1929c20785315a81effe245874cdc57acb709bf868e00778a96984338c1b29dafdb453c6847747694621c6ecf5da2259993
GODOT_EXPORT_TEMPLATES_SHA512=ca4d71c4d7b81dfc15d1a98baa07534aa95b03fdda78a0075b06672e1648d2e5f40980c9adc28d23e1b92e732ee7bf3461997aa804af74ec2fcd7a93ccb84079

# Browser smoke test (scripts/ci/smoke). PLAYWRIGHT_VERSION must equal the exact version in
# scripts/ci/smoke/package.json and package-lock.json (checked by check_workflows.py). The Chromium build is implied by it.
NODE_VERSION=24.22.0
PLAYWRIGHT_VERSION=1.64.1

# Workflow linting (pipeline self-test only). Checksums are from the actionlint release's checksums.txt.
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_LINUX_AMD64_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_WINDOWS_AMD64_SHA256=6e7241b51e6817ea6a047693d8e6fed13b31819c9a0dd6c5a726e1592d22f6e9

# Every workflow must use exactly this runner label (never *-latest, which migrates silently).
RUNNER_IMAGE=ubuntu-24.04
